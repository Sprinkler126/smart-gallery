# PhotoWall Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Analysis Configuration (required for AI features)
AI_API_ENDPOINT=https://coding.dashscope.aliyuncs.com/v1/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=qwen3.5-plus

# Optional: require this token for remote admin writes.
# Local/private hosts can still manage the gallery without it.
# ADMIN_TOKEN=choose-a-long-random-token

# Optional: Server Configuration
# PORT=3001
# HOST=0.0.0.0
