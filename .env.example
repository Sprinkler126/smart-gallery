# PhotoWall Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Analysis Configuration (required for AI features)
AI_API_ENDPOINT=https://coding.dashscope.aliyuncs.com/v1/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=qwen3.5-plus

# Admin authentication is initialized on the deployment machine:
# npm run auth:init -- --write-env
# Do not copy production secrets into this example file.
# AUTH_PASSWORD_HASH=
# AUTH_TOTP_SECRET=
# AUTH_SESSION_SECRET=

# Optional: Server Configuration
# PORT=3001
# HOST=0.0.0.0
