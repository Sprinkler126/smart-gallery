# PhotoWall Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Analysis Configuration (required for AI features)
AI_API_ENDPOINT=https://coding.dashscope.aliyuncs.com/v1/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=qwen3.5-plus

# AI analysis speed tuning
# AI_IMAGE_DETAIL=low
# AI_MAX_TOKENS=8000
# AI_TEMPERATURE=0.2
# MAX_CONCURRENT_ANALYSIS=4
# AI_BATCH_DELAY_MS=0

# Optional Redis cache (disabled by default)
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=smart-gallery

# Optional: Server Configuration
# PORT=3001
# HOST=0.0.0.0
