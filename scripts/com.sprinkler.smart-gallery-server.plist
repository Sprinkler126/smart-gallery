<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sprinkler.smart-gallery-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@24/bin/node</string>
    <string>server/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sprinkler/openclaw/smart-gallery</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/sprinkler/openclaw/smart-gallery/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sprinkler/openclaw/smart-gallery/logs/server.log</string>
</dict>
</plist>
